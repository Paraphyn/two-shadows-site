{%- comment -%} Feeding table with the pack label's dog silhouettes. {%- endcomment -%}
{% render 'dog-sprite' %}
<table class="feed">
  <thead><tr><th scope="col">Dog’s weight</th><th scope="col">Chews a day</th><th scope="col">One jar lasts</th></tr></thead>
  <tbody>
    <tr><td><span class="fw"><span class="dog"><svg class="dog-s" aria-hidden="true" focusable="false"><use href="#dog-s"/></svg></span>Under 10 kg</span></td><td>1</td><td>60 days</td></tr>
    <tr><td><span class="fw"><span class="dog"><svg class="dog-m" aria-hidden="true" focusable="false"><use href="#dog-m"/></svg></span>10–30 kg</span></td><td>2</td><td>30 days</td></tr>
    <tr><td><span class="fw"><span class="dog"><svg class="dog-l" aria-hidden="true" focusable="false"><use href="#dog-l"/></svg></span>30–45 kg</span></td><td>3</td><td>20 days</td></tr>
    <tr><td><span class="fw"><span class="dog"><svg class="dog-xl" aria-hidden="true" focusable="false"><use href="#dog-xl"/></svg></span>Over 45 kg</span></td><td>4</td><td>15 days</td></tr>
  </tbody>
</table>
