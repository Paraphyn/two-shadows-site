{%- if request.page_type == 'index' -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ request.origin | append: '/' | json }},
    "email": {{ settings.contact_email | json }},
    "areaServed": "GB"
    {%- if settings.social_instagram != blank or settings.social_tiktok != blank -%}
      ,"sameAs": [{% if settings.social_instagram != blank %}{{ settings.social_instagram | json }}{% endif %}{% if settings.social_instagram != blank and settings.social_tiktok != blank %},{% endif %}{% if settings.social_tiktok != blank %}{{ settings.social_tiktok | json }}{% endif %}]
    {%- endif %}
  }
</script>
{%- endif -%}
