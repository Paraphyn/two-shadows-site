<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#FFFFFF">
    {% render 'favicons' %}
    {% render 'meta-tags' %}
    {% render 'fonts' %}
    {{ 'ts.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
    {% render 'structured-data-site' %}
  </head>
  <body class="tpl-{{ template.name }}{% if template.suffix %} tpl-{{ template.name }}-{{ template.suffix }}{% endif %}">
    <a class="skip" href="#main">{{ 'general.skip' | t }}</a>
    {% sections 'header-group' %}
    <main id="main">
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}
    {% section 'cart-drawer' %}
    <script src="{{ 'ts.js' | asset_url }}" defer></script>
  </body>
</html>
