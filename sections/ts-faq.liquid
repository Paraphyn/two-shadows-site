<section class="sec tint-sand" id="faq" aria-labelledby="fq-{{ section.id }}">
  <div class="wrap faq-in">
    <div>
      <div class="kicker">{{ section.settings.kicker }}</div>
      <h2 class="h2" id="fq-{{ section.id }}" style="margin-bottom:20px">{{ section.settings.heading }}</h2>
      <p class="lead" style="margin-bottom:20px">{% render 'rt', t: section.settings.lead %}</p>
      <a class="tlink" href="{{ routes.root_url }}pages/contact">{{ section.settings.contact_label }}</a>
    </div>
    <div>
      <div class="acc">
        {%- for block in section.blocks -%}
          <details {{ block.shopify_attributes }}><summary><span>{{ block.settings.question }}</span>{% render 'icon-chevron' %}</summary>
            <div class="ans">{%- if block.settings.draft -%}<span class="draft ph">Draft · confirm with manufacturer</span> {% endif -%}{% render 'rt', t: block.settings.answer %}</div>
          </details>
        {%- endfor -%}
      </div>
      {%- if section.settings.all_link_label != blank -%}
        <a class="btn btn-ghost" href="{{ routes.root_url }}pages/faq" style="margin-top:32px">{{ section.settings.all_link_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>
{%- if section.settings.structured_data -%}
  {%- capture qa -%}
    {%- for block in section.blocks -%}
      {%- unless block.settings.draft or block.settings.answer contains '[' -%}
        {"@type":"Question","name":{{ block.settings.question | strip_html | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.answer | strip_html | strip | json }}}},
      {%- endunless -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- assign qa = qa | strip | remove_last: ',' -%}
  {%- if qa != blank -%}
    <script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{{ qa }}]}</script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "class": "section-faq",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Good questions" },
    { "type": "text", "id": "lead", "label": "Lead", "default": "Can’t find what you need? We’re happy to help." },
    { "type": "text", "id": "contact_label", "label": "Contact link label", "default": "Get in touch" },
    { "type": "text", "id": "all_link_label", "label": "“All questions” button label", "info": "Leave empty on the FAQ page itself" },
    { "type": "checkbox", "id": "structured_data", "label": "Output FAQPage structured data", "info": "Turn on only on the main FAQ page. Drafts and answers with [placeholders] are left out.", "default": false }
  ],
  "blocks": [ { "type": "question", "name": "Question", "settings": [
    { "type": "text", "id": "question", "label": "Question", "default": "Question" },
    { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer</p>" },
    { "type": "checkbox", "id": "draft", "label": "Draft (confirm with manufacturer)", "default": false }
  ] } ],
  "presets": [ { "name": "FAQ" } ]
}
{% endschema %}
