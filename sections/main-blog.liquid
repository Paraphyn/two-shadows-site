<section class="page-hero"><div class="wrap"><h1>{{ blog.title }}</h1></div></section>
<section class="sec" style="padding-top:24px"><div class="wrap">
  {%- paginate blog.articles by 12 -%}
    <div class="cards">
      {%- for article in blog.articles -%}
        <article class="card">
          {%- if article.image -%}{{ article.image | image_url: width: 800 | image_tag: widths: '400, 800', sizes: '(max-width: 760px) 100vw, 33vw', loading: 'lazy' }}{%- endif -%}
          <h3><a href="{{ article.url }}">{{ article.title }}</a></h3>
          <p>{{ article.excerpt_or_content | strip_html | truncatewords: 28 }}</p>
        </article>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}<nav class="toc" aria-label="{{ 'general.pagination' | t }}">{{ paginate | default_pagination }}</nav>{%- endif -%}
  {%- endpaginate -%}
</div></section>
{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
