<section class="sec{% if section.settings.tint %} tint{% endif %}" aria-labelledby="tc-{{ section.id }}">
  <div class="wrap two-col">
    <div>{% if section.settings.kicker != blank %}<div class="kicker">{{ section.settings.kicker }}</div>{% endif %}<h2 class="h2" id="tc-{{ section.id }}">{{ section.settings.heading }}</h2></div>
    <div class="prose">{% render 'rt', t: section.settings.text %}</div>
  </div>
</section>

{% schema %}
{
  "name": "Heading + text",
  "class": "section-two-col",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "tint", "label": "Tinted background", "default": false }
  ],
  "presets": [ { "name": "Heading + text" } ]
}
{% endschema %}
