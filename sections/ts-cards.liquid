<section class="sec{% if section.settings.tint %} tint{% endif %}"{% if section.settings.compact %} style="padding-top:64px"{% endif %} aria-label="{{ section.settings.heading | default: section.settings.aria | escape }}">
  <div class="wrap">
    {%- if section.settings.heading != blank -%}
      <div class="sec-head"><div>{% if section.settings.kicker != blank %}<div class="kicker">{{ section.settings.kicker }}</div>{% endif %}<h2 class="h2">{{ section.settings.heading }}</h2></div></div>
    {%- endif -%}
    <div class="cards">
      {%- for block in section.blocks -%}
        <div class="card" {{ block.shopify_attributes }}>
          <h3>{% render 'rt', t: block.settings.title %}</h3>
          {%- if block.settings.big != blank %}<p class="big">{% render 'rt', t: block.settings.big %}</p>{% endif -%}
          {% render 'rt', t: block.settings.text %}
          {%- if block.settings.link_label != blank %}<a class="tlink" href="{{ block.settings.link_url }}">{{ block.settings.link_label }}</a>{% endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cards",
  "class": "section-cards",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "aria", "label": "Accessible name if no heading", "default": "Highlights" },
    { "type": "checkbox", "id": "tint", "label": "Tinted background", "default": false },
    { "type": "checkbox", "id": "compact", "label": "Less space above", "default": false }
  ],
  "blocks": [ { "type": "card", "name": "Card", "limit": 6, "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Title" },
    { "type": "inline_richtext", "id": "big", "label": "Highlighted line" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link_url", "label": "Link" }
  ] } ],
  "presets": [ { "name": "Cards" } ]
}
{% endschema %}
