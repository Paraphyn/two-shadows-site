<section class="sec" aria-labelledby="bl-{{ section.id }}">
  <div class="wrap benefits-in">
    <div><h2 class="h2" id="bl-{{ section.id }}">{{ section.settings.heading }}</h2></div>
    <div class="benefit-list">
      {%- for block in section.blocks -%}
        <div class="benefit" {{ block.shopify_attributes }}>
          <span class="ic">
            {%- case block.settings.icon -%}
              {%- when 'flora' -%}<svg width="26" height="26" viewBox="0 0 48 48" fill="none" stroke="#6B3550" stroke-width="2.4" aria-hidden="true"><circle cx="24" cy="24" r="16"/><circle cx="18" cy="20" r="3"/><circle cx="29" cy="18" r="2"/><circle cx="27" cy="29" r="3.5"/></svg>
              {%- when 'clock' -%}<svg width="26" height="26" viewBox="0 0 48 48" fill="none" stroke="#6B3550" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="24" cy="24" r="16"/><path d="M24 14v10l7 5"/></svg>
              {%- else -%}<svg width="26" height="26" viewBox="0 0 48 48" fill="none" stroke="#6B3550" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M14 10c0 8 20 6 20 14s-20 6-20 14"/><path d="M14 10h6M28 38h6"/></svg>
            {%- endcase -%}
          </span>
          <h3>{% render 'rt', t: block.settings.title %}</h3>
          <p>{% render 'rt', t: block.settings.text %}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Benefits",
  "class": "section-benefits",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "They look after us. This is one small way to look after them." } ],
  "blocks": [ { "type": "benefit", "name": "Benefit", "limit": 6, "settings": [
    { "type": "select", "id": "icon", "label": "Icon", "options": [ { "value": "gut", "label": "Gut" }, { "value": "flora", "label": "Flora" }, { "value": "clock", "label": "Clock" } ], "default": "gut" },
    { "type": "text", "id": "title", "label": "Title", "default": "Daily digestive support" },
    { "type": "text", "id": "text", "label": "Text", "default": "A live culture and prebiotic fibre in every chew." }
  ] } ],
  "presets": [ { "name": "Benefits" } ]
}
{% endschema %}
