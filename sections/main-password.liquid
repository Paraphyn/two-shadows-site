<section class="page-hero" style="min-height:70vh;display:flex;align-items:center"><div class="wrap">
  <div class="kicker">{{ section.settings.kicker }}</div>
  {% render 'logo-mark', class: 'pw-mark' %}
  <h1>{{ shop.name }}</h1>
  <div class="lead">{{ shop.password_message | default: section.settings.text }}</div>
  {%- form 'customer', class: 'batch-form', style: 'max-width:620px;margin-top:28px' -%}
    <input type="hidden" name="contact[tags]" value="waitlist">
    {%- if form.posted_successfully? -%}
      <p role="status">{{ 'footer.newsletter_success' | t }}</p>
    {%- else -%}
      <label class="vh" for="WaitEmail">{{ 'footer.email' | t }}</label>
      <input id="WaitEmail" type="email" name="contact[email]" placeholder="{{ 'footer.email' | t }}" required style="text-transform:none;letter-spacing:0">
      <button class="btn" type="submit">{{ 'password.notify' | t }}</button>
    {%- endif -%}
  {%- endform -%}
  <details style="margin-top:40px"><summary class="tlink">{{ 'password.owner' | t }}</summary>
    {%- form 'storefront_password', class: 'batch-form', style: 'max-width:620px;margin-top:16px' -%}
      {%- if form.errors -%}<p role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      <label class="vh" for="StorePassword">{{ 'password.label' | t }}</label>
      <input id="StorePassword" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.label' | t }}" style="text-transform:none;letter-spacing:0">
      <button class="btn btn-ghost" type="submit">{{ 'password.enter' | t }}</button>
    {%- endform -%}
  </details>
</div></section>
{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Coming soon" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>UK-made soft chews for dogs, with a live gut-flora culture. Leave your email and we’ll tell you when we open.</p>" }
  ]
}
{% endschema %}
