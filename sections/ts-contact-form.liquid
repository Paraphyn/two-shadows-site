<section class="sec" aria-labelledby="cf-{{ section.id }}">
  <div class="wrap two-col">
    <div><div class="kicker">{{ section.settings.kicker }}</div><h2 class="h2" id="cf-{{ section.id }}">{{ section.settings.heading }}</h2><p class="lead" style="margin-top:16px">{% render 'rt', t: section.settings.lead %}</p></div>
    <div>
      {%- form 'contact', class: 'contact-form' -%}
        {%- if form.posted_successfully? -%}
          <p class="card" role="status">{{ 'contact.success' | t }}</p>
        {%- else -%}
          {%- if form.errors -%}<div class="form-err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
          <label><span>{{ 'contact.name' | t }}</span><input type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}"></label>
          <label><span>{{ 'contact.email' | t }} *</span><input type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"></label>
          <label><span>{{ 'contact.order' | t }}</span><input type="text" name="contact[order_or_batch]"></label>
          <label><span>{{ 'contact.message' | t }} *</span><textarea name="contact[body]" rows="6" required>{{ form.body }}</textarea></label>
          <button type="submit" class="btn">{{ 'contact.send' | t }}</button>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "class": "section-contact-form",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Write to us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Send a message" },
    { "type": "text", "id": "lead", "label": "Lead", "default": "We read every message and reply by email." }
  ],
  "presets": [ { "name": "Contact form" } ]
}
{% endschema %}
