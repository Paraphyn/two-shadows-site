<section class="sec tint" aria-labelledby="ht-{{ section.id }}">
  <div class="wrap how-in">
    <div>
      <div class="kicker">{{ section.settings.kicker }}</div>
      <h2 class="h2" id="ht-{{ section.id }}">{{ section.settings.heading }}</h2>
      <ol class="steps">
        {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}><div><b>{% render 'rt', t: block.settings.title %}</b><span>{% render 'rt', t: block.settings.text %}</span></div></li>{%- endfor -%}
      </ol>
      {%- if section.settings.button_label != blank -%}<a href="{{ section.settings.button_link | default: '#product' }}" class="btn btn-ghost" style="margin-top:32px">{{ section.settings.button_label }}</a>{%- endif -%}
    </div>
    <div class="how-img">{% render 'ts-image', image: section.settings.image, asset: 'how-golden.webp', width: 752, height: 1344, alt: section.settings.image_alt, sizes: '(max-width: 760px) 100vw, 40vw' %}</div>
  </div>
</section>

{% schema %}
{
  "name": "How to use",
  "class": "section-howto",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "How to use" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Part of the day they already love" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Gut & Digestion" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Empty = scroll to the product section" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Alt text for the built-in photo", "default": "A Golden Retriever taking a soft chew from an open hand in a sunny kitchen" }
  ],
  "blocks": [ { "type": "step", "name": "Step", "limit": 5, "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Step" },
    { "type": "text", "id": "text", "label": "Text" }
  ] } ],
  "presets": [ { "name": "How to use" } ]
}
{% endschema %}
