<section class="page-hero"><div class="wrap">
  <h1>{{ collection.title }}</h1>
  {%- if collection.description != blank %}<div class="lead">{{ collection.description }}</div>{% endif -%}
</div></section>
<section class="sec" style="padding-top:24px"><div class="wrap">
  {%- paginate collection.products by 24 -%}
    <ul class="product-grid">
      {%- for p in collection.products -%}
        <li class="card">
          <a href="{{ p.url }}">{%- if p.featured_image -%}{{ p.featured_image | image_url: width: 600 | image_tag: widths: '300, 600', sizes: '(max-width: 760px) 50vw, 25vw', loading: 'lazy' }}{%- endif -%}</a>
          <h3><a href="{{ p.url }}">{{ p.title }}</a></h3>
          <p class="big">{{ p.price | money }}</p>
        </li>
      {%- else -%}
        <li><p>{{ 'collection.empty' | t }}</p></li>
      {%- endfor -%}
    </ul>
    {%- if paginate.pages > 1 -%}<nav class="toc" aria-label="{{ 'general.pagination' | t }}">{{ paginate | default_pagination }}</nav>{%- endif -%}
  {%- endpaginate -%}
</div></section>
{% schema %}
{ "name": "Collection", "settings": [] }
{% endschema %}
